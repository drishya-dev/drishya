{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "docs-static",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-m", "http.server", "5178", "--bind", "127.0.0.1", "--directory", "docs"],
      "port": 5178
    },
    {
      "name": "drishya",
      "runtimeExecutable": "node",
      "runtimeArgs": ["apps/daemon/src/cli.ts", "serve", "--no-open", "--port", "7878"],
      "env": { "DRISHYA_TOKEN": "local-preview-token", "DRISHYA_HOME": ".drishya-preview" },
      "port": 7878
    }
  ]
}
