{
  "name": "drishya-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "node apps/daemon/src/cli.ts serve --dev",
    "serve": "node apps/daemon/src/cli.ts serve",
    "drishya": "node apps/daemon/src/cli.ts",
    "ui:dev": "pnpm --filter @drishya/ui dev",
    "ui:build": "pnpm --filter @drishya/ui build",
    "package:build": "pnpm ui:build && node scripts/build-package.ts",
    "package:verify": "pnpm package:build && node scripts/verify-package.ts",
    "demo:bundle": "node apps/daemon/src/cli.ts demo-bundle --out apps/ui/public/demo/bundle.json",
    "test": "vitest run",
    "test:browser": "pnpm ui:build && node scripts/test-browser.ts",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit && pnpm --filter @drishya/ui typecheck",
    "check": "pnpm typecheck && pnpm test",
    "check:real": "node scripts/check-real.ts",
    "check:affected": "node scripts/check-affected.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.3.0",
    "esbuild": "0.28.2",
    "typescript": "^5.9.2",
    "vite": "^8.3.6",
    "vitest": "^4.1.12"
  }
}
