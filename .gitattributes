# Normalize line endings in the repository; check out native per platform.
# Without this, two builders on different OSes see every file as fully changed.
* text=auto

# Shell scripts MUST keep LF. With CRLF they fail on macOS/Linux with
# "bad interpreter: /usr/bin/env bash^M".
*.sh text eol=lf

# PowerShell is happiest with CRLF on Windows.
*.ps1 text eol=crlf

# Fixtures and golden outputs are byte-exact: observation ids use byte offsets and the
# repository map hashes file sizes, so a CRLF checkout would change them.
fixtures/** text eol=lf
**/__golden__/** text eol=lf
apps/ui/public/demo/** text eol=lf

# Never touch these.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.mp4 binary
*.woff binary
*.woff2 binary
*.wasm binary
